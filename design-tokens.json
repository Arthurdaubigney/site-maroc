        "$value": "#7A6D61"
      },
      "450": {
        "$type": "color",
        "$value": "#8A7C6F"
      },
      "400": {
        "$type": "color",
        "$value": "#9C8F81"
      },
      "300": {
        "$type": "color",
        "$value": "#C9BCAC"
      },
      "250": {
        "$type": "color",
        "$value": "#CDBFAE"
      }
    },
    "terracotta": {
      "300": {
        "$type": "color",
        "$value": "#EEA285"
      },
      "350": {
        "$type": "color",
        "$value": "#EDA88D"
      },
      "400": {
        "$type": "color",
        "$value": "#E39070"
      },
      "700": {
        "$type": "color",
        "$value": "#9A3F25"
      },
