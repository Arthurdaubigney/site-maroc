        "$value": "#7F321C"
      }
    },
    "brass": {
      "500": {
        "$type": "color",
        "$value": "#A9864F"
      },
      "400": {
        "$type": "color",
        "$value": "#C9A66B"
      }
    },
    "cream": {
      "$type": "color",
      "$value": "#FFFBF5"
    },
    "danger": {
      "700": {
        "$type": "color",
        "$value": "#A12622"
      },
      "300": {
        "$type": "color",
        "$value": "#F2A39B"
      }
    },
    "success": {
      "700": {
        "$type": "color",
        "$value": "#2F6246"
      },
      "300": {
        "$type": "color",
        "$value": "#9ED0B2"
      }
    }
  },
  "semantic": {
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.paper.50}",
        "$description": "Fond de page, papier chaud"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.paper.25}",
        "$description": "Surfaces elevees (formulaire, cartes)"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.paper.100}",
        "$description": "Bandeaux de section alternes"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.ink.880}",
        "$description": "Bandeau fonce de reassurance et pied de page"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.ink.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.ink.700}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.ink.500}",
        "$description": "Metadonnees uniquement"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.terracotta.750}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.cream}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.paper.100}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.ink.250}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.brass.500}",
        "$description": "Decor et texte sur fond fonce uniquement (3.2:1 sur papier)"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.terracotta.700}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.terracotta.800}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.paper.200}",
        "$description": "Decoratif : separateurs, bords de carte"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.ink.450}",
        "$description": "Bord essentiel des champs (>= 3:1)"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.700}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.700}"
      }
    }
  },
  "system": {
    "$description": "Tokens non colores, emis tels quels en variables CSS (--radius-*, --shadow-*, --duration-*, --ease-*, --size-*)",
    "radius": {
      "frame": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Cadres photo : angle net, comme un encadrement"
      },
      "control": {
        "$type": "dimension",
        "$value": "6px",
        "$description": "Boutons, champs"
      },
      "card": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Panneaux et formulaire"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$description": "Etiquettes"
      }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": "0 2px 16px rgb(31 26 22 / 0.08)"
      },
      "overlay": {
        "$type": "shadow",
        "$value": "0 12px 40px rgb(31 26 22 / 0.18)"
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "220ms"
      },
      "spin": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Rotation de l'indicateur de chargement"
      }
    },
    "ease": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      }
    },
    "size": {
      "header": {
        "$type": "dimension",
        "$value": "4.5rem",
        "$description": "Hauteur du header collant ; sert aussi au scroll-padding (WCAG 2.4.11)"
      },
      "focus-ring": {
        "$type": "dimension",
        "$value": "3px"
      }
    }
  },
  "dark": {
    "$description": "Surcharges semantiques du mode sombre",
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{primitive.ink.950}"
      },
      "card": {
        "$type": "color",
        "$value": "{primitive.ink.850}"
      },
      "band": {
        "$type": "color",
        "$value": "{primitive.ink.825}"
      },
      "deep": {
        "$type": "color",
        "$value": "{primitive.ink.925}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.paper.100}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.ink.300}"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.ink.400}"
      },
      "link": {
        "$type": "color",
        "$value": "{primitive.terracotta.300}"
      },
      "on-action": {
        "$type": "color",
        "$value": "{primitive.ink.900}"
      },
      "on-deep": {
        "$type": "color",
        "$value": "{primitive.paper.100}"
      },
      "on-deep-muted": {
        "$type": "color",
        "$value": "{primitive.ink.300}"
      },
      "ornament": {
        "$type": "color",
        "$value": "{primitive.brass.400}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.terracotta.400}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{primitive.terracotta.350}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{primitive.ink.800}"
      },
      "strong": {
        "$type": "color",
        "$value": "{primitive.ink.450}"
      }
    },
    "feedback": {
      "error-text": {
        "$type": "color",
        "$value": "{primitive.danger.300}"
      },
      "success-text": {
        "$type": "color",
        "$value": "{primitive.success.300}"
      }
    }
  }
}
