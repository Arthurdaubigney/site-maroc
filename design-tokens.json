{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Source unique du theme du site. Primitive -> semantic -> dark. scripts/build-tokens.mjs genere src/tokens.css a partir de ce fichier ; ne jamais editer tokens.css a la main.",
  "primitive": {
